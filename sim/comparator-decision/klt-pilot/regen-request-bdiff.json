{
  "netlist": "regen-body-bdiff.spice",
  "engine": "ngspice",
  "models": {"pdk": "sky130A", "lib": "libs.tech/combined/sky130.lib.spice"},
  "corners": {"process": ["tt", "ss"], "temperature_c": [27, -40]},
  "exclude": [
    {"process": "tt", "temperature_c": -40},
    {"process": "ss", "temperature_c": 27}
  ],
  "batch": {"runner_version_check": "warn", "capacity_wait_s": 600},
  "analysis": {"kind": "tran", "args": "0.005n 45.1n"},
  "measurements": [
    {"name": "t_dec_right", "spice": ".meas tran t_dec_right WHEN v(DIFF)=0.9 CROSS=1 TD=5.1n", "unit": "s", "on_unreached": "null"},
    {"name": "t_dec_wrong", "spice": ".meas tran t_dec_wrong WHEN v(DIFF)=-0.9 CROSS=1 TD=5.1n", "unit": "s", "on_unreached": "null"}
  ],
  "options": {"timeout_s": 600, "keep_artifacts": true, "ngspice_init": ["set measureprec=12", "set numdgt=12"]}
}
