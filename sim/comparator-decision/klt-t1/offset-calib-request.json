{
  "netlist": "bodies/offset-pickoff-body.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt"
    ],
    "temperature_c": [
      27
    ],
    "params": {
      "vind_diff_mv": [
        1.0,
        2.0,
        5.0,
        10.0
      ]
    }
  },
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 600
  },
  "analysis": {
    "kind": "tran",
    "args": "0.002n 7.6n"
  },
  "measurements": [
    {
      "name": "pkdiff_mv",
      "unit": "mV",
      "spice": ".meas tran pkdiff_mv FIND par('(v(OUTP) - v(OUTN))*1000') AT=5.75n"
    }
  ],
  "options": {
    "timeout_s": 300,
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
