{
  "netlist": "bodies/kickback-body-loaded.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "ff",
      "fs",
      "sf",
      "ss",
      "tt"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "exclude": [
    {
      "process": "ff",
      "temperature_c": -40
    },
    {
      "process": "ff",
      "temperature_c": 27
    },
    {
      "process": "fs",
      "temperature_c": 27
    },
    {
      "process": "sf",
      "temperature_c": 27
    },
    {
      "process": "ss",
      "temperature_c": 27
    },
    {
      "process": "ss",
      "temperature_c": 125
    },
    {
      "process": "tt",
      "temperature_c": -40
    },
    {
      "process": "tt",
      "temperature_c": 125
    }
  ],
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 600
  },
  "analysis": {
    "kind": "tran",
    "args": "0.005n 45.1n"
  },
  "measurements": [
    {
      "name": "vinp_pk_mv",
      "unit": "mV",
      "limits": {
        "max": 5.0
      },
      "spec_row": "kickback",
      "spice": ".meas tran vinp_pk_mv MAX par('abs(v(VINP) - 0.925)*1000') FROM=0 TO=45.1n"
    },
    {
      "name": "vinn_pk_mv",
      "unit": "mV",
      "limits": {
        "max": 5.0
      },
      "spec_row": "kickback",
      "spice": ".meas tran vinn_pk_mv MAX par('abs(v(VINN) - 0.875)*1000') FROM=0 TO=45.1n"
    }
  ],
  "options": {
    "timeout_s": 450,
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
