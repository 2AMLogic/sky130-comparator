{
  "netlist": "bodies/noise-body.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "ff",
      "fs",
      "sf",
      "ss",
      "tt"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "exclude": [
    {
      "process": "ff",
      "temperature_c": -40
    },
    {
      "process": "ff",
      "temperature_c": 27
    },
    {
      "process": "fs",
      "temperature_c": 27
    },
    {
      "process": "sf",
      "temperature_c": 27
    },
    {
      "process": "ss",
      "temperature_c": 27
    },
    {
      "process": "ss",
      "temperature_c": 125
    },
    {
      "process": "tt",
      "temperature_c": -40
    },
    {
      "process": "tt",
      "temperature_c": 125
    }
  ],
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 600
  },
  "analysis": {
    "kind": "noise",
    "args": "v(outp1,outn1) Vinp dec 20 1000 1000000000 20"
  },
  "measurements": [
    {
      "name": "inoise_diff_mv",
      "unit": "mV",
      "limits": {
        "max": 1.0
      },
      "spec_row": "noise_ir_ac",
      "expr": "inoise_total*sqrt(2)*1000"
    },
    {
      "name": "inoise_band_v",
      "unit": "V",
      "noise": {
        "quantity": "inoise",
        "band_hz": [
          1000,
          1000000000
        ]
      }
    }
  ],
  "options": {
    "timeout_s": 600,
    "ngspice_init": [
      "option sparse",
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
